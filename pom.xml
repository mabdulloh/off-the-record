<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.mabdulloh</groupId>
    <artifactId>off-the-record-core</artifactId>
    <version>0.3.0</version>
    <packaging>jar</packaging>

    <name>off-the-record-core</name>
    <description>Annotation-driven redaction for Java records and beans. Zero runtime dependencies.</description>
    <url>https://github.com/mabdulloh/off-the-record</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- developers and scm are not optional: Central rejects a deployment without them. -->
    <developers>
        <developer>
            <name>Muhammad Abdulloh</name>
            <email>muhammad.abdulloh93@gmail.com</email>
            <url>https://github.com/mabdulloh</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/mabdulloh/off-the-record.git</connection>
        <developerConnection>scm:git:git@github.com:mabdulloh/off-the-record.git</developerConnection>
        <url>https://github.com/mabdulloh/off-the-record</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!-- Test scope only. The library has no runtime dependencies. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
                <executions>
                    <execution>
                        <!--
                          Tests only. The all-args copy mechanism matches constructor parameters by name,
                          which needs -parameters, and the test beans have to be compiled that way to
                          exercise it. The published classes are unaffected.
                        -->
                        <id>default-testCompile</id>
                        <configuration>
                            <parameters>true</parameters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>io.github.mabdulloh.offtherecord</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Jacoco -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version> <!-- Use the latest version available -->
                <executions>
                    <!-- Prepares the property pointing to the JaCoCo runtime agent -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- Creates the code coverage report after tests run -->
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <!--
      Everything needed to publish to Maven Central, kept out of the default build so that a normal
      `mvn verify` needs neither a GPG key nor a javadoc run. Profile id matches the converter project.

          mvn -Ppublish verify     dry run: builds and signs the three jars, uploads nothing
          mvn -Ppublish deploy     the real thing

      Prerequisites:
        1. A non-SNAPSHOT <version> above. Central rejects snapshots on the release endpoint.
        2. A Portal token in ~/.m2/settings.xml under <server><id>central</id>, using the token
           username and password from https://central.sonatype.com/account
        3. A GPG key published to a keyserver. Locally, leave the passphrase out of Maven entirely and
           let gpg-agent prompt for it. maven-gpg-plugin 3.2+ fails the build if the passphrase is kept
           in settings.xml, and for CI it reads the MAVEN_GPG_PASSPHRASE environment variable instead.

      autoPublish is left at its default of false, so the upload is validated and then waits for you to
      press publish at https://central.sonatype.com/publishing/deployments. Set it to true, as the
      converter project does, once the first release has gone through and you trust the pipeline.
    -->
    <profiles>
        <profile>
            <id>publish</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
